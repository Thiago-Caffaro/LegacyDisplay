{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legacydisplay.local/schemas/layout-v1.json",
  "title": "LegacyDisplay layout v1",
  "description": "Native PoC widgets. Runtime validation also enforces unique ids and geometry within screen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "screen",
    "widgets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        }
      }
    },
    "widgets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/widget"
      }
    }
  },
  "$defs": {
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        },
        "type": {
          "enum": [
            "text",
            "value",
            "button"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "action": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "$ref": "#/$defs/style"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "value"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "button"
                ]
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
              }
            }
          },
          "else": {
            "properties": {
              "action": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        },
        "fontSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "fontWeight": {
          "enum": [
            "normal",
            "bold"
          ]
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "borderRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "$comment": "Runtime additionally enforces UTF-16 string limits and ordinary integer literals, without decimal/exponent notation."
}
