<Window x:Class="LegacyDisplay.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LegacyDisplay.Studio"
    Title="LegacyDisplay Studio" Width="1440" Height="940" MinWidth="1180" MinHeight="760"
    Background="#101820" Foreground="#ECF3F7" FontFamily="Segoe UI" FontSize="13"
    Loaded="WindowLoaded" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#6DE5B7" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#233544" /><Setter Property="Foreground" Value="#ECF3F7" />
            <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="3" />
            <Setter Property="BorderBrush" Value="#3B5263" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C141C" /><Setter Property="Foreground" Value="#ECF3F7" />
            <Setter Property="BorderBrush" Value="#3B5263" /><Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,3,0,8" /><Setter Property="CaretBrush" Value="#6DE5B7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3,0,8" /><Setter Property="Padding" Value="7,5" />
            <Setter Property="Foreground" Value="#101820" /><Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D5E1E8" /><Setter Property="Margin" Value="5" /></Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#101820" /><Setter Property="Foreground" Value="#ECF3F7" />
            <Setter Property="BorderBrush" Value="#304656" /><Setter Property="Padding" Value="3" />
        </Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,7" /></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A7BAC8" /><Setter Property="FontSize" Value="12" /></Style>
        <Style x:Key="Section" TargetType="TextBlock"><Setter Property="Foreground" Value="#6DE5B7" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,14,0,8" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="132" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#14212C" Padding="18,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="LegacyDisplay" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="STUDIO" FontSize="11" Margin="12,9,28,0" Foreground="#A7BAC8" />
                    <Button Content="Novo" Click="NewClick" /><Button Content="Abrir" Click="OpenClick" />
                    <Button Content="Salvar" Click="SaveClick" /><Button Content="Salvar como" Click="SaveAsClick" />
                    <Button x:Name="UndoButton" Content="Desfazer" Click="UndoClick" /><Button x:Name="RedoButton" Content="Refazer" Click="RedoClick" />
                    <Button Content="Ações" Click="ActionsClick" />
                </StackPanel>
                <Button x:Name="DeployButton" DockPanel.Dock="Right" Content="DEPLOY NO TABLET" Click="DeployClick"
                    Background="#6DE5B7" Foreground="#101820" FontWeight="Bold" Padding="20,9" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="#182733" Padding="18,10" BorderBrush="#304656" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Tablet" Width="55" VerticalAlignment="Center" />
                    <TextBox x:Name="DeviceUrlBox" Width="300" Margin="0,3,6,3" TextChanged="DeviceUrlChanged" ToolTip="Endereço mostrado no tablet. Ex.: http://192.168.1.70:8765" />
                    <Button x:Name="ConnectButton" Content="Conectar" Click="ConnectClick" />
                    <Button x:Name="UsbButton" Content="Detectar USB" Click="UsbClick" />
                    <TextBlock Text="Código" Margin="14,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="PairCodeBox" Width="85" MaxLength="6" Margin="0,3,4,3" ToolTip="Código de seis dígitos mostrado no tablet" />
                    <Button x:Name="PairButton" Content="Parear" Click="PairClick" />
                    <Button x:Name="ReadTabletButton" Content="Ler layout do tablet" Click="ReadTabletClick" />
                </DockPanel>
                <DockPanel LastChildFill="False" Margin="0,7,0,0">
                    <TextBlock x:Name="DeviceStateText" Text="Configure o endereço ou conecte o USB." Foreground="#A7BAC8" VerticalAlignment="Center" Width="535" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="StartAgentButton" Content="Iniciar Agent" Click="StartAgentClick" />
                    <Button x:Name="StopAgentButton" Content="Parar Agent" Click="StopAgentClick" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox x:Name="KeepScreenCheck" Content="Manter tela ligada" IsEnabled="False" />
                    <CheckBox x:Name="StartBootCheck" Content="Iniciar ao ligar o tablet" IsEnabled="False" />
                    <Button x:Name="DeviceConfigButton" Content="Aplicar opções do tablet" Click="DeviceConfigClick" Padding="9,3" IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#15222D" Padding="14" BorderBrush="#304656" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="225" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="ADICIONAR WIDGET" Style="{StaticResource Section}" Margin="0,0,0,8" />
                        <UniformGrid Columns="3"><Button Content="Text" Click="AddTextClick" Padding="5,8" /><Button Content="Value" Click="AddValueClick" Padding="5,8" /><Button Content="Button" Click="AddButtonClick" Padding="5,8" /></UniformGrid>
                        <TextBlock x:Name="WidgetCountText" Text="WIDGETS" Style="{StaticResource Section}" />
                    </StackPanel>
                    <ListBox x:Name="WidgetList" Grid.Row="1" DisplayMemberPath="Id" SelectedValuePath="Id" SelectionChanged="WidgetSelectionChanged" />
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <UniformGrid Columns="2"><Button Content="Duplicar" Click="DuplicateClick" Padding="5,6" /><Button Content="Excluir" Click="DeleteClick" Padding="5,6" /></UniformGrid>
                        <UniformGrid Columns="2"><Button Content="Para trás" Click="BackwardClick" Padding="5,6" /><Button Content="Para frente" Click="ForwardClick" Padding="5,6" /></UniformGrid>
                        <TextBlock Text="FONTES DO PC" Style="{StaticResource Section}" />
                        <TextBlock x:Name="GpuStatusText" Text="GPU · detectando sensores…" FontSize="11" Foreground="#A7BAC8" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </StackPanel>
                    <ListBox x:Name="SourcesList" Grid.Row="3" MouseDoubleClick="SourceDoubleClick">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding Id}" FontSize="10" Foreground="#A7BAC8" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Background="#101820" LastChildFill="False" Margin="14,0">
                    <TextBlock x:Name="ScreenLabel" Text="800 × 1280" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock Text="Zoom" Margin="20,0,8,0" VerticalAlignment="Center" />
                    <Slider x:Name="ZoomSlider" Minimum="15" Maximum="125" Value="45" Width="125" VerticalAlignment="Center" ValueChanged="ZoomChanged" />
                    <TextBlock x:Name="ZoomLabel" Text="45 %" Width="45" VerticalAlignment="Center" Margin="8,0" />
                    <CheckBox x:Name="SnapCheck" Content="Snap 8 px" IsChecked="True" VerticalAlignment="Center" Checked="SnapChanged" Unchecked="SnapChanged" />
                </DockPanel>
                <local:LayoutCanvas x:Name="PreviewCanvas" Grid.Row="1" />
            </Grid>
            <Border Grid.Column="2" Background="#15222D" BorderBrush="#304656" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="TELA" Style="{StaticResource Section}" Margin="0,0,0,8" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,5,0"><TextBlock Text="Largura" Style="{StaticResource Label}" /><TextBox x:Name="ScreenWidthBox" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Altura" Style="{StaticResource Label}" /><TextBox x:Name="ScreenHeightBox" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Cor de fundo · #RRGGBB" Style="{StaticResource Label}" /><TextBox x:Name="ScreenBackgroundBox" MaxLength="7" />
                        <Button Content="Aplicar tela" Click="ScreenApplyClick" Margin="0,0,0,8" />
                        <TextBlock x:Name="SelectionTitle" Text="PROPRIEDADES · selecione um widget" Style="{StaticResource Section}" TextWrapping="Wrap" />
                        <StackPanel x:Name="Inspector" IsEnabled="False">
                            <TextBlock Text="Id" Style="{StaticResource Label}" /><TextBox x:Name="IdBox" MaxLength="64" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,5,0"><TextBlock Text="X" Style="{StaticResource Label}" /><TextBox x:Name="XBox" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Y" Style="{StaticResource Label}" /><TextBox x:Name="YBox" /></StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,5,0"><TextBlock Text="Largura" Style="{StaticResource Label}" /><TextBox x:Name="WidthBox" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Altura" Style="{StaticResource Label}" /><TextBox x:Name="HeightBox" /></StackPanel>
                            </Grid>
                            <StackPanel x:Name="TextField"><TextBlock Text="Texto" Style="{StaticResource Label}" /><TextBox x:Name="WidgetTextBox" MaxLength="256" AcceptsReturn="True" Height="65" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                            <StackPanel x:Name="SourceField"><TextBlock Text="Fonte de dados" Style="{StaticResource Label}" /><ComboBox x:Name="SourceBox" IsEditable="True" DisplayMemberPath="Id" /><TextBlock Text="Formato · use {value}" Style="{StaticResource Label}" /><TextBox x:Name="FormatBox" MaxLength="128" /></StackPanel>
                            <StackPanel x:Name="ActionField"><TextBlock Text="Ação cadastrada no Windows" Style="{StaticResource Label}" /><ComboBox x:Name="ActionBox" IsEditable="True" DisplayMemberPath="Id" /><Button Content="Gerenciar ações…" Click="ActionsClick" /></StackPanel>
                            <TextBlock Text="ESTILO" Style="{StaticResource Section}" />
                            <TextBlock Text="Fundo · #RRGGBB" Style="{StaticResource Label}" /><TextBox x:Name="BackgroundBox" MaxLength="7" />
                            <TextBlock Text="Texto · #RRGGBB" Style="{StaticResource Label}" /><TextBox x:Name="ColorBox" MaxLength="7" />
                            <TextBlock Text="Tamanho da fonte" Style="{StaticResource Label}" /><TextBox x:Name="FontSizeBox" />
                            <CheckBox x:Name="BoldCheck" Content="Negrito" />
                            <TextBlock Text="Alinhamento" Style="{StaticResource Label}" />
                            <ComboBox x:Name="AlignmentBox" SelectedValuePath="Tag"><ComboBoxItem Content="Esquerda" Tag="left" /><ComboBoxItem Content="Centro" Tag="center" /><ComboBoxItem Content="Direita" Tag="right" /></ComboBox>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,5,0"><TextBlock Text="Raio dos cantos" Style="{StaticResource Label}" /><TextBox x:Name="RadiusBox" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Padding" Style="{StaticResource Label}" /><TextBox x:Name="PaddingBox" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Opacidade · 0 a 1" Style="{StaticResource Label}" /><TextBox x:Name="OpacityBox" />
                            <Button x:Name="ApplyPropertiesButton" Content="Aplicar alterações" Click="PropertiesApplyClick" Background="#6DE5B7" Foreground="#101820" FontWeight="Bold" Margin="0,5,0,14" />
                        </StackPanel>
                        <TextBlock Text="Reserve os últimos 48 px para o rodapé do tablet." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#182733" Padding="14,0">
            <DockPanel><TextBlock x:Name="DocumentStateText" DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="#A7BAC8" VerticalAlignment="Center" /><TextBlock x:Name="StatusText" Text="Editor pronto · Ctrl+S salva · Ctrl+Z desfaz" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
        </Border>
    </Grid>
</Window>
